{
  "name": "dsh-quota-panel",
  "description": "Minimal draggable quota capsule: one-line readings, two-line expanded view and a persistent position lock.",
  "version": "0.8.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/plugin-integration-v1.js",
    "lib/capsule.css",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node scripts/test-page-script.mjs",
    "demo": "node scripts/gen-demo.mjs",
    "verify": "node scripts/verify-capsule.mjs",
    "verify:dark": "node scripts/verify-capsule.mjs",
    "verify:drag": "node scripts/verify-capsule.mjs",
    "verify:route": "node scripts/verify-route.mjs",
    "verify:desktop": "node scripts/verify-desktop-host.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "screenshot": "node scripts/verify-capsule.mjs",
    "showcase": "node scripts/gen-showcase.mjs",
    "pack": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist",
    "check": "npm run test && npm run demo && npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "balance",
    "usage",
    "cost",
    "opencode",
    "commandcode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brittanistrehlowll-oss/dsh-quota-panel.git"
  }
}
